<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EsuEcosMiddleman</RootNamespace>
    <AssemblyName>EsuEcosMiddleman</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="WatsonWebsocket" Version="4.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="log4net.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="packages.config" Visible="false" />
    <Content Include="EsuEcosMiddleman.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Protocol.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Renderer\renderer.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Renderer\renderer.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ECoS\SimulationData\Reply_1_info.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ECoS\SimulationData\Reply_1_status.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>